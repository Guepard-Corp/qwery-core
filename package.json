{
  "name": "qwery-core",
  "version": "0.2.3",
  "description": "AI data agent with a TUI, talk your data with confidence.",
  "homepage": "https://qwery.run",
  "author": {
    "url": "https://guepard.run",
    "name": "Guepard Inc."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qwery-run/qwery-core"
  },
  "bugs": {
    "url": "https://github.com/qwery-run/qwery-core/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.x"
  },
  "keywords": [
    "ai",
    "agentic-ai",
    "database",
    "sql",
    "data-engineering",
    "mysql",
    "mongodb",
    "nosql",
    "clickhouse",
    "postgresql",
    "sqlserver",
    "duckdb"
  ],
  "private": false,
  "workspaces": [
    "apps/cli",
    "apps/e2e",
    "packages/domain",
    "packages/application",
    "packages/telemetry",
    "packages/agent-factory-sdk",
    "packages/extension-sdk",
    "packages/adapters/branching-gfs",
    "packages/adapters/compute-duckdb",
    "packages/adapters/llm-aisdk",
    "packages/adapters/persistence-sqlite",
    "packages/adapters/model-catalog-http",
    "packages/adapters/semantic-inprocess",
    "packages/extensions/csv-local",
    "packages/extensions/xlsx-local",
    "packages/extensions/parquet",
    "packages/extensions/postgresql",
    "packages/extensions/csv-online",
    "packages/extensions/json-online",
    "packages/extensions/gsheet-csv",
    "packages/extensions/s3",
    "packages/extensions/duckdb",
    "packages/extensions/mysql",
    "packages/extensions/clickhouse-node",
    "evals"
  ],
  "scripts": {
    "start": "bun apps/cli/src/main.tsx",
    "dev": "bun --watch apps/cli/src/main.tsx",
    "diag": "bun run scripts/diag.ts",
    "build:release": "bun run scripts/build-release.ts",
    "typecheck": "tsc -b",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "coverage": "bun test --coverage && bun run tooling/coverage-gate.ts",
    "coverage:html": "bun test --coverage && lcov-viewer lcov -o coverage/html coverage/lcov.info && echo 'open coverage/html/index.html'",
    "check:arch": "depcruise --config tooling/dep-cruiser.config.cjs apps packages",
    "check:coverage": "bun run tooling/coverage-gate.ts",
    "check:privacy": "bun run tooling/privacy-check.ts",
    "check:all": "bun run lint && bun run typecheck && bun run check:arch && bun run check:privacy && bun run test:coverage",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bash tooling/hook-precommit.sh",
    "commit-msg": "bun x commitlint --edit ${1}",
    "pre-push": "bash tooling/hook-prepush.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@lcov-viewer/cli": "^1.3.0",
    "@types/bun": "^1.3.14",
    "@types/mustache": "^4.2.6",
    "@types/react": "^19.2.15",
    "dependency-cruiser": "^17.4.0",
    "drizzle-kit": "^0.31.10",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "duckdb": "^1.4.4"
  }
}
