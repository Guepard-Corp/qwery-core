{
  "name": "@qwery/extension-gsheet-csv",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./driver": "./src/driver.ts",
    "./schema": "./src/schema.ts"
  },
  "contributes": {
    "datasources": [
      {
        "id": "gsheet-csv",
        "name": "Google Sheets (CSV)",
        "description": "Query a public Google Sheet via its CSV export, one view per tab.",
        "docsUrl": "https://support.google.com/docs/answer/2494822",
        "tags": ["Files", "SaaS"],
        "icon": "📊",
        "drivers": ["gsheet-csv.duckdb"]
      }
    ],
    "drivers": [
      {
        "id": "gsheet-csv.duckdb",
        "name": "DuckDB (Node)",
        "description": "DuckDB-backed driver for Google Sheets CSV export",
        "runtime": "node",
        "entry": "./src/driver.ts"
      }
    ]
  },
  "dependencies": {
    "@qwery/domain": "workspace:*",
    "@qwery/extension-sdk": "workspace:*",
    "zod": "^4.4.3"
  }
}
