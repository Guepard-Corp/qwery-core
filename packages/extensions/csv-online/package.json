{
  "name": "@qwery/extension-csv-online",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./driver": "./src/driver.ts",
    "./schema": "./src/schema.ts"
  },
  "contributes": {
    "datasources": [
      {
        "id": "csv-online",
        "name": "CSV (Online)",
        "description": "Query a public CSV file by http(s) URL via DuckDB.",
        "tags": ["Files"],
        "icon": "🌐",
        "drivers": ["csv-online.duckdb"]
      }
    ],
    "drivers": [
      {
        "id": "csv-online.duckdb",
        "name": "DuckDB (Node)",
        "description": "DuckDB-backed driver for online CSV files",
        "runtime": "node",
        "entry": "./src/driver.ts"
      }
    ]
  },
  "dependencies": {
    "@qwery/domain": "workspace:*",
    "@qwery/extension-sdk": "workspace:*",
    "zod": "^4.4.3"
  }
}
